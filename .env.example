APP_NAME="LoanPlatform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loan_platform
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@loanplatform.com"
MAIL_FROM_NAME="LoanPlatform"

# ─── CPay (Chaperone Payments) ────────────────────────────────────────────────
# Get these from https://cpay-uat-env.chaperone.co.ls:5100 (UAT) or your CPay merchant portal
CPAY_CLIENT_CODE=           # Your CPay merchant/client code
CPAY_API_KEY=               # Bearer token / API key
CPAY_SECRET_KEY=            # HMAC-SHA256 secret for checksum validation
CPAY_SANDBOX=true           # true = UAT, false = production
CPAY_LIVE_URL=https://api.chaperone.co.ls  # Production URL (confirm with CPay)
